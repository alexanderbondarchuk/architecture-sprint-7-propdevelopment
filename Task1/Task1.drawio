        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-304" value="&lt;span&gt;При потере персональных данных клиентов будет невозможно обсдуживание при личном обращении. Потребуется организация мероприятий по восстановлению этих данных, что может не пройти незаметно для клиентов.&lt;br&gt;Отсутствие важных документов и юриидических обязательств с клиентами и партнёрами может нести финансовые и репутационные риски в случае спорных и судебных ситуаций.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;fontSize=12;strokeColor=inherit;align=left;" parent="Gi_X9hFvUgJvlZ2b7QkZ-301" vertex="1">
          <mxGeometry x="294" width="426" height="120" as="geometry">
            <mxRectangle width="426" height="120" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-305" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;strokeColor=inherit;" parent="Gi_X9hFvUgJvlZ2b7QkZ-292" vertex="1">
          <mxGeometry y="200" width="720" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-306" value="Искажение данных" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;fontSize=12;strokeColor=inherit;" parent="Gi_X9hFvUgJvlZ2b7QkZ-305" vertex="1">
          <mxGeometry width="141" height="60" as="geometry">
