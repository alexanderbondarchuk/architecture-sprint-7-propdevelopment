          </mxGeometry>
        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-275" value="Утечка технической и регламентной документации по схеме работы компании, повлечёт за собой существенные репутационные риски. Кроме самого факта утечки могут быть опубликованы &quot;личные&quot; подробности процессов компании, которые могут быть интерпретированы как несовершенные, а так же быть использованы для осуществления попытки обхода технологической защиты или фишинговых процессов против сотрудников компании.&lt;br&gt;Положительные подробности работы компании, являющиеся конкурентным преимуществом, могут быть использованы конкурентами и такое преимущество будет нивелировано." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;fontSize=12;strokeColor=inherit;align=left;" parent="Gi_X9hFvUgJvlZ2b7QkZ-272" vertex="1">
          <mxGeometry x="294" width="426" height="160" as="geometry">
            <mxRectangle width="426" height="160" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-276" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;strokeColor=inherit;" parent="Gi_X9hFvUgJvlZ2b7QkZ-267" vertex="1">
          <mxGeometry y="190" width="720" height="110" as="geometry" />
        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-277" value="Потеря данных" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;fontSize=12;strokeColor=inherit;" parent="Gi_X9hFvUgJvlZ2b7QkZ-276" vertex="1">
          <mxGeometry width="141" height="110" as="geometry">
