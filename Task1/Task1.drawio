        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-350" value="&lt;span&gt;Утечка ключей, даных для авторизации может привести к компрометации, взлому системы и других последствий для клиентов собственников, в том числе финансовых в других системах.&lt;br&gt;Как следствие серьёзная потеря репутации компании, юридические риски, штрафы и ответственность вплоть до уголовной.&lt;/span&gt;&lt;span style=&quot;text-align: right;&quot;&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;fontSize=12;strokeColor=inherit;align=left;" parent="Gi_X9hFvUgJvlZ2b7QkZ-347" vertex="1">
          <mxGeometry x="294" width="426" height="90" as="geometry">
            <mxRectangle width="426" height="90" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-351" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;strokeColor=inherit;" parent="Gi_X9hFvUgJvlZ2b7QkZ-342" vertex="1">
          <mxGeometry y="120" width="720" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-352" value="Потеря данных" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;fontSize=12;strokeColor=inherit;" parent="Gi_X9hFvUgJvlZ2b7QkZ-351" vertex="1">
