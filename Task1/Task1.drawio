        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-273" value="Утечка данных" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;fontSize=12;strokeColor=inherit;" parent="Gi_X9hFvUgJvlZ2b7QkZ-272" vertex="1">
