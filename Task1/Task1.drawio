        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-358" value="Некорректные настройки или ключи доступа приведут к сбоям, включая полный отказ систем и неавторизованный доступ. Подмена данных в документах или ключей нарушит работу сервисов и юридические обязательства." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;fontSize=12;strokeColor=inherit;align=left;" parent="Gi_X9hFvUgJvlZ2b7QkZ-355" vertex="1">
          <mxGeometry x="294" width="426" height="68" as="geometry">
            <mxRectangle width="426" height="68" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-359" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;strokeColor=inherit;" parent="Gi_X9hFvUgJvlZ2b7QkZ-342" vertex="1">
          <mxGeometry y="258" width="720" height="80" as="geometry" />
        </mxCell>
        <mxCell id="Gi_X9hFvUgJvlZ2b7QkZ-360" value="Некачественные данные" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;fontSize=12;strokeColor=inherit;" parent="Gi_X9hFvUgJvlZ2b7QkZ-359" vertex="1">
